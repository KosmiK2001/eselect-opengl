#!/bin/bash
# opengl-detect: set eselect-opengl provider to match the loaded GPU kernel
# module, so that X starts with GL libraries consistent with the driver.
# Intended to run once at boot, before any display manager.
#
# Module -> provider mapping:
#   nvidia (proprietary, non-glvnd legacy)  -> nvidia
#   fglrx (Catalyst)                        -> fglrx
#   nouveau / radeon / amdgpu / i915        -> xorg-x11 (glvnd mesa)
#   nothing loaded                          -> xorg-x11 (sane default)

load_profile() {
	local f=/etc/env.d/000opengl
	[[ -f ${f} ]] && sed -n 's/^OPENGL_PROFILE="\?\([^"]*\)"\?$/\1/p' "${f}"
}

have_provider() {
	local impl=$1 libdir
	for libdir in /usr/lib64 /usr/lib32 /usr/lib; do
		[[ -f ${libdir}/opengl/${impl}/lib/libGL.so.1 ]] && return 0
	done
	return 1
}

# true if the provider is already fully applied (profile + shim links),
# so we can skip rewriting anything (keeps the .path trigger loop-free)
provider_applied() {
	local impl=$1 libdir shim soname prov link
	[[ $(eselect opengl show 2>/dev/null) == "${impl}" ]] || return 1
	for libdir in /usr/lib64 /usr/lib32; do
		[[ -d ${libdir} ]] || continue
		for shim in libGLX libOpenGL; do
			soname="${shim}.so.0"
			prov="${libdir}/opengl/${impl}/lib/${soname}"
			link=$(readlink "${libdir}/${soname}" 2>/dev/null) || return 1
			if [[ -e ${prov} ]]; then
				[[ ${link} == "${prov}" ]] || return 1
			else
				[[ ${link} == "${libdir}/${soname}.0.0.0" && -e ${libdir}/${soname}.0.0.0 ]] || return 1
			fi
		done
	done
	return 0
}

set_provider() {
	local impl=$1
	if provider_applied "${impl}"; then
		return 0
	fi
	if have_provider "${impl}"; then
		echo "opengl-detect: switching OpenGL provider to ${impl}"
		eselect opengl set "${impl}" >/dev/null
	else
		echo "opengl-detect: provider ${impl} not populated, keeping ${current:-xorg-x11}"
	fi
}

detect_module() {
	local mod
	for mod in nvidia fglrx nouveau radeon amdgpu i915; do
		if lsmod 2>/dev/null | grep -qw "${mod}"; then
			echo "${mod}"
			return 0
		fi
	done
	return 1
}

# Single-GPU nvidia systems: nouveau may be holding the GPU for the boot
# splash. Hand the GPU over to the proprietary module before X starts
# (same flow the old gpu-switch-to-nvidia service performed).
hand_gpu_to_nvidia() {
	lspci -n 2>/dev/null | grep -qiE " 0300[.:] 10de:" || return 0
	lsmod 2>/dev/null | grep -qw nouveau || return 0
	modinfo nvidia >/dev/null 2>&1 || return 0

	echo "opengl-detect: handing GPU over from nouveau to nvidia"
	modprobe -r nouveau drm_ttm_helper ttm drm_gpuvm gpu_sched drm_exec \
		drm_display_helper drm_kms_helper drm 2>/dev/null
	sleep 1
	lsmod 2>/dev/null | grep -qw nouveau && rmmod nouveau 2>/dev/null
	sleep 1
	modprobe nvidia 2>/dev/null
}

hand_gpu_to_nvidia

mod=$(detect_module) || mod=""

case ${mod} in
	nvidia)  set_provider nvidia ;;
	fglrx)   set_provider fglrx ;;
	*)       set_provider xorg-x11 ;;
esac
